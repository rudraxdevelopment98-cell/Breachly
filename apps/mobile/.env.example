# aegis mobile (Expo) — copy to .env; never commit .env.
# Only EXPO_PUBLIC_* vars are exposed to the app bundle — never put secrets here.

# When true (default), the app uses local mock data and needs no backend.
EXPO_PUBLIC_USE_MOCK=true

# Base URL of the aegis exposure-service (same contract as the web app).
# On a simulator, localhost works; on a physical device use your machine's LAN IP,
# e.g. http://192.168.1.20:4002
EXPO_PUBLIC_API_BASE=http://localhost:4002
