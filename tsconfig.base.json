{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@aegis/crypto": ["packages/crypto/src/index.ts"],
      "@aegis/types": ["packages/types/src/index.ts"],
      "@aegis/audit": ["packages/audit/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
