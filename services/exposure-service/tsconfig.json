{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2021",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*.ts"]
}
