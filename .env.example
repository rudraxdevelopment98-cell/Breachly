# aegis — environment variables (copy to .env; never commit .env)

# ---- Shared ----
NODE_ENV=development

# ---- auth-service ----
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegis_auth?schema=public
# Signing secrets for short-lived access + refresh JWTs (rotate in prod).
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900          # seconds (15m)
JWT_REFRESH_TTL=2592000     # seconds (30d)
AUTH_SERVICE_PORT=4001

# ---- exposure-service ----
EXPOSURE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegis_exposure?schema=public
# HIBP secret key — SERVER-SIDE ONLY. Never bundle into web/mobile clients.
HIBP_API_KEY=
# California DROP API (sandbox opens 2026) — leave blank until provisioned.
CA_DROP_API_KEY=
CA_DROP_API_BASE=
REDIS_URL=redis://localhost:6379
EXPOSURE_SERVICE_PORT=4002

# ---- apps/web ----
# Public base URL for the BFF / services the browser talks to.
NEXT_PUBLIC_API_BASE=http://localhost:4002
# When true, the web dashboard uses local mock data (no backend needed).
NEXT_PUBLIC_USE_MOCK=true
